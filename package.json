{
  "name": "supermail",
  "version": "0.1.0",
  "description": "Local-first, keyboard-driven desktop mail for people who live in their inbox",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaisenye/supermail.git"
  },
  "homepage": "https://github.com/kaisenye/supermail",
  "bugs": {
    "url": "https://github.com/kaisenye/supermail/issues"
  },
  "license": "MIT",
  "author": "Kaisen Ye",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.7",
    "better-sqlite3": "^13.0.1",
    "dompurify": "^3.4.12",
    "imapflow": "^1.4.8",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.25.0",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "pdfjs-dist": "^6.2.108",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^28.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
