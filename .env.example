# Copy to .env.local and fill in. Never commit .env.local.

SOVO_EMAIL=you@yourdomain.com
SOVO_PASS=<app-specific password>
SOVO_NAME=Your Full Name

# Optional — defaults target Tencent Exmail
# SOVO_IMAP_HOST=imap.exmail.qq.com
# SOVO_IMAP_PORT=993
# SOVO_SMTP_HOST=smtp.exmail.qq.com
# SOVO_SMTP_PORT=465

# Optional — "Continue with Google / Microsoft". Baked in at build time.
# Google: Cloud console → OAuth client of type "Desktop app".
# MAIN_VITE_GOOGLE_CLIENT_ID=
# MAIN_VITE_GOOGLE_CLIENT_SECRET=
# Microsoft: Entra app registration (public client, redirect http://localhost/callback).
# MAIN_VITE_MS_CLIENT_ID=
